{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "art-show-chat",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "SHOW", "class_name": "ShowRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ShowRoom"] }],
  "observability": { "enabled": true }
}
